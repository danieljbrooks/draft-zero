+func TestValidateRefusesAOneCandidateTopK(t *testing.T) {
+	for _, k := range []int{-1, 1} {
+		opts := DefaultOptions()
+		opts.PriorTopK = k
+		if err := opts.Validate(nil); err == nil {
+			t.Fatalf("PriorTopK %d accepted", k)
+		}
+	}
+	opts := DefaultOptions()
+	opts.PriorTopK = 2
+	if err := opts.Validate(hashNet()); err != nil {
+		t.Fatal(err)
+	}
