+func (f kindFixture) matches(d *decision.Decision) bool {
+	if d.Player != f.player || d.Kind != f.want || d.Min != f.min || d.Max != f.max || len(d.Options) != f.n {
+		return false
+	}
+	return f.optKind == "" || d.Options[0].Kind == f.optKind
+}
