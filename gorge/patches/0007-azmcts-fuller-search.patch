+// sumScore is the sum of the chosen options' scores, -Inf when a choice is
+// out of range.
+func sumScore(scores []float32, choices []int) float64 {
+	s := 0.0
+	for _, c := range choices {
+		if c < 0 || c >= len(scores) {
+			return math.Inf(-1)
+		}
+		s += float64(scores[c])
+	}
+	return s
