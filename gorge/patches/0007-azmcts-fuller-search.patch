+// manualBot is the default (manual-payment) bot's answer at r's root.
+func manualBot(t *testing.T, r measureRoot) decision.Intent {
+	t.Helper()
+	in, err := seat.NewBot(7).Decide(context.Background(), view.Project(r.e.G, r.e, r.d.Player, r.d), *r.d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return in
+}
