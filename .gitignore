# Generated data, runs and models: regenerable or published elsewhere, never committed. Anchored to the repo root
# (a bare `data/` would also hide src/draftzero/data/ and docs/data/). data/ holds data/17lands and data/deckgen
# (tools/extract_decks.py), data/gorge (deck pool in gorge format, game records, packs) and data/sealed.
/data/
/runs/
/models/
/logs/

# gorge builds (engine/gorge/build.sh): the checkout with bin/dzgorge, its build record and the Forge card
# corpus (.cards, GPL-3.0) live outside the repo (GORGE_DIR, default ../ext/gorge-dz). Never commit them if one
# lands inside.
/ext/
/engine/gorge/*/
.cards/
dzgorge
dzgorge.build.json

__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.venv/
.pytest_cache/
.DS_Store

# Private notes: access details for machines other people lend us. This repo is public, so
# hostnames, usernames and login steps stay out of git.
docs/private/
